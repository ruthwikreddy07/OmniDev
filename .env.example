# OmniDev Environment Configuration Template
# Duplicate this file to .env and insert your API keys

# 1. AI Model API Keys (choose one or more)
GEMINI_API_KEY=""
OPENAI_API_KEY=""
ANTHROPIC_API_KEY=""

# 2. Server Configuration
PORT=4000
NODE_ENV="development"

# 3. Redis Configuration (for background job queues)
REDIS_HOST="127.0.0.1"
REDIS_PORT=6379

# 4. n8n & Slack Webhook Endpoints
N8N_WEBHOOK_URL="http://localhost:5678/webhook/omnidev-trigger"
SLACK_WEBHOOK_URL=""
