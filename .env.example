# OmniDev Environment Configuration Template
# Copy to .env for local development (never commit .env to Git)

# 1. Database (PostgreSQL URL for production, leave blank for local SQLite omnidev.db)
DATABASE_URL=""

# 2. LLM Provider (Optional fallback on server; users can also provide their own key in UI Settings)
GROQ_API_KEY=""

# 3. Server Configuration
PORT=4000

# 4. n8n Webhook Endpoint
N8N_WEBHOOK_URL="https://n8n-mr7m.onrender.com/webhook/omnidev-github-incident"
